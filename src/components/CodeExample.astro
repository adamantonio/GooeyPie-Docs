---
// src/components/WidgetExample.astro
import { Code } from '@astrojs/starlight/components';
import fs from 'node:fs/promises';
import path from 'node:path';

interface Props {
  name: string;   // e.g., "clicker"
  title?: string; // Optional title for the example
  mark?: string | number | Array<string | number>; // New prop for highlighting
  noCode?: boolean;
  zoom?: number; // Optional zoom level for the video
}

const { name, title, mark, noCode = false, zoom = 0.6 } = Astro.props;

// 1. Resolve and read the Python file

let codeString = "";
if (!noCode) {
  const filePath = path.join(process.cwd(), 'src/assets/code-examples', `${name}.py`);

  try {
    codeString = await fs.readFile(filePath, 'utf-8');
  } catch (e) {
    codeString = `# Error: Could not find ${name}.py`;
  }
}

// 2. Construct the video path (assumes it lives in public/videos/widgets/)
const videoSrcLight = `/videos/code-examples/${name}_light.mp4`;
const videoSrcDark = `/videos/code-examples/${name}_dark.mp4`;
---

<div class="example-container">
  <!-- {title && <h3 class="example-title">{title}</h3>} -->
  
  <div class="example-grid">
    <div class="video-player">
      <video
        data-light={videoSrcLight}
        data-dark={videoSrcDark}
        playsinline
        muted
        preload="metadata"
        style={`zoom: ${zoom};`}>
      </video>
      
      <div class="controls-overlay">
        <div class="buttons">
          <button class="play-btn" aria-label="Play">
            <i class="fa fa-play"></i>
          </button>
        </div>
        <div class="progress-container">
          <progress value="0" max="1"></progress>
          <input type="range" class="seek-slider" value="0" max="100" step="0.1" />
        </div>
      </div>
    </div>
    
    {!noCode && (
      <div class="example-code">
        <Code code={codeString} lang="python" title={`${name}.py`} mark={mark} />
      </div>
    )}

  </div>
</div>

<script src="../scripts/controls.js"></script>

<style>
  .example-container {
    background-color: #000000 !important;
    border: 1px solid #262626;
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin-inline: 0;
    margin-block: 1rem 2rem;
  }

  .example-title { color: #ffffff !important; margin-bottom: 1rem; }

  .video-player {
    position: relative;
    width: 100%;
    background: #000;
    border-radius: 4px;
    overflow: hidden;
  }

  video {
    zoom: 0.75;
    max-width: 100%;
    height: auto;

    display: block;
    margin-inline: auto;
  
    /* Keeps the pixels sharp if the browser does need to scale it slightly */
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
  }

  .controls-overlay {
    background-color: #000000;
    display: grid;
    grid-template-columns: auto 1fr;
    align-content: center;
    gap: 1rem;
    width: 50%;
    margin-inline: auto;
    margin-top: 0.5rem;
  }

  .video-player:hover .controls-overlay{
    opacity: 1;
  }

  /* Progress Bar & Seek Slider */
  .progress-container {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0;
    margin: 0;
  }
  
  progress {
    width: 100%;
    height: 4px;
    appearance: none;
    border: none;
    background: #444;
    border-radius: 2px;
  }

  /* Starlight Brand Color for Progress */
  progress::-webkit-progress-value { background-color: #60a5fa; }
  progress::-moz-progress-bar { background-color: #60a5fa; }

  .seek-slider {
    position: absolute;
    width: 100%;
    top: 0;
    left: 0;
    opacity: 0; /* Invisible but clickable/draggable */
    cursor: pointer;
    height: 100%;
    margin: 0;
  }

  .play-btn {
    background: none;
    border: none;
    /* color: var(--sl-color-white); */
    color: #ffffff !important;
    cursor: pointer;
    font-size: 1.2rem;
    padding: 0;
  }

  .play-btn:hover {
    /* color: var(--sl-color-accent);  */
    color: #60a5fa !important;
  }

</style>
