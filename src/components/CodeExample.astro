---
// src/components/WidgetExample.astro
import { Code } from '@astrojs/starlight/components';
import fs from 'node:fs/promises';
import path from 'node:path';

interface Props {
  name: string;
  title?: string;
  mark?: string | number | Array<string | number>;
  noCode?: boolean;
  zoom?: number;
  static?: boolean; // New: Defaults to false (video) for backward compatibility
}

const { name, title, mark, noCode = false, zoom = 0.6, static: isStatic = false } = Astro.props;

// 1. Python file
let codeString = "";
if (!noCode) {
  const filePath = path.join(process.cwd(), 'src/assets/code-examples', `${name}.py`);
  try {
    codeString = await fs.readFile(filePath, 'utf-8');
  } catch (e) {
    codeString = `# Error: Could not find ${name}.py`;
  }
}

// 2. File paths
const videoSrcLight = `/videos/code-examples/${name}_light.mp4`;
const videoSrcDark = `/videos/code-examples/${name}_dark.mp4`;
const imageSrcLight = `/images/code-examples/${name}_light.png`;
const imageSrcDark = `/images/code-examples/${name}_dark.png`;
---

<div class="example-container">
  <div class="example-grid">
    <div class="media-area">
      {isStatic ? (
        /* Static Image  */
        <img 
          src={imageSrcLight} 
          data-light={imageSrcLight} 
          data-dark={imageSrcDark} 
          alt={`${name} layout example`} 
          style={`zoom: ${zoom};`}
          class="example-media static-img" 
        />
      ) : (
        /* Video example with custom media controls */
        <div class="video-player">
          <video
            data-light={videoSrcLight}
            data-dark={videoSrcDark}
            playsinline
            muted
            preload="metadata"
            style={`zoom: ${zoom};`}
            class="example-media">
          </video>
          
          <div class="controls-overlay">
            <div class="buttons">
              <button class="play-btn" aria-label="Play">
                <i class="fa fa-play"></i>
              </button>
            </div>
            <div class="progress-container">
              <progress value="0" max="1"></progress>
              <input type="range" class="seek-slider" value="0" max="100" step="0.1" />
            </div>
          </div>
        </div>
      )}
    </div>
    
    {!noCode && (
      <div class="example-code">
        <Code code={codeString} lang="python" title={`${name}.py`} mark={mark} />
      </div>
    )}
  </div>
</div>

<script src="../scripts/controls.js"></script>

<style>
  /* Reuse your existing container and player styles [cite: 1109-1123] */
  .example-container {
    background-color: #000000 !important;
    border: 1px solid #262626;
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin-block: 1rem 2rem;
  }

  .media-area {
    background: #000;
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .example-media {
    max-width: 100%;
    height: auto;
    display: block;
    margin-inline: auto;
    /* Keeps the pixels sharp for UI elements [cite: 1113-1114] */
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
  }

  /* ... Keep all other .controls-overlay, .progress-container, etc. styles ... */
</style>
